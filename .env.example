# Database
DATABASE_URL=postgresql+asyncpg://finsight:finsight123@localhost:5432/finsight_db
DATABASE_SYNC_URL=postgresql+psycopg2://finsight:finsight123@localhost:5432/finsight_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RAW_TRANSACTIONS=raw-transactions
KAFKA_TOPIC_UPI_EVENTS=upi-events
KAFKA_TOPIC_ALERTS=compliance-alerts
KAFKA_TOPIC_DLQ=dlq-transactions

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here

# Auth
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# App
APP_ENV=development
APP_DEBUG=true

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
