{
  "title": "FinSight Compliance Engine",
  "uid": "finsight-main",
  "schemaVersion": 38,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Transaction Throughput (per minute)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "rate(finsight_transactions_ingested_total[1m]) * 60",
        "legendFormat": "Transactions/min"
      }],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      }
    },
    {
      "id": 2,
      "title": "Alerts by Severity",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(finsight_alerts_created_total{severity='critical'}[5m]) * 300",
          "legendFormat": "Critical"
        },
        {
          "datasource": "Prometheus",
          "expr": "rate(finsight_alerts_created_total{severity='high'}[5m]) * 300",
          "legendFormat": "High"
        },
        {
          "datasource": "Prometheus",
          "expr": "rate(finsight_alerts_created_total{severity='medium'}[5m]) * 300",
          "legendFormat": "Medium"
        }
      ],
      "fieldConfig": {
        "overrides": [
          { "matcher": { "id": "byName", "options": "Critical" }, "properties": [{ "id": "color", "value": { "fixedColor": "#c0392b", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "High" }, "properties": [{ "id": "color", "value": { "fixedColor": "#e67e22", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Medium" }, "properties": [{ "id": "color", "value": { "fixedColor": "#f39c12", "mode": "fixed" } }] }
        ]
      }
    },
    {
      "id": 3,
      "title": "Anomaly Score Distribution",
      "type": "histogram",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "rate(finsight_anomaly_score_bucket[5m])",
        "legendFormat": "{{le}}"
      }],
      "options": {
        "bucketSize": "auto",
        "fillOpacity": 80
      }
    },
    {
      "id": 4,
      "title": "API Request Latency P99 (ms)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket[5m])) * 1000",
        "legendFormat": "P99 Latency"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "fixedColor": "#3498db", "mode": "fixed" }
        }
      }
    },
    {
      "id": 5,
      "title": "SAR Generation Latency (seconds)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 16, "w": 6, "h": 4 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "histogram_quantile(0.95, rate(finsight_sar_generation_seconds_bucket[10m]))",
        "legendFormat": "P95 SAR Latency"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "steps": [{"color":"green","value":0},{"color":"yellow","value":15},{"color":"red","value":30}] } } }
    },
    {
      "id": 6,
      "title": "Total Transactions Flagged",
      "type": "stat",
      "gridPos": { "x": 6, "y": 16, "w": 6, "h": 4 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "finsight_transactions_flagged_total",
        "legendFormat": "Flagged"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "#e74c3c", "mode": "fixed" } } }
    },
    {
      "id": 7,
      "title": "DLQ Messages Total",
      "type": "stat",
      "gridPos": { "x": 12, "y": 16, "w": 6, "h": 4 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "sum(finsight_dlq_messages_total)",
        "legendFormat": "DLQ Total"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "#e67e22", "mode": "fixed" } } }
    },
    {
      "id": 8,
      "title": "SARs Generated",
      "type": "stat",
      "gridPos": { "x": 18, "y": 16, "w": 6, "h": 4 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "sum(finsight_sar_generated_total)",
        "legendFormat": "SARs"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "#27ae60", "mode": "fixed" } } }
    }
  ]
}
